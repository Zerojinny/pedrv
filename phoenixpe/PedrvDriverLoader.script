[Main]
Title=pedrv Driver Loader
Description=Adds pedrv to the PE to load the drivers this machine needs from a folder (.inf folders, .zip, .7z, .wim) into the running PE. Optional: run it at PE startup, Desktop / Start Menu shortcuts.
Author=pedrv
Level=6
Selected=False
Mandatory=False
Version=1.2.0.0
Date=2026-11-16

[Variables]
%ProgramFolder%="pedrv"
%ProgramExe%="pedrv.exe"
%IncludeChoice%="Include in the PE image"
%MediaChoice%="Folder on the boot media or a disk"
%LogFile%="X:\Windows\Temp\pedrv.log"

[Process]
Echo,"Processing %ScriptTitle%..."

// ---- pedrv.exe: encoded in this script (folder "pedrv", x64), or an external file ----
DirMake,"%TargetPrograms%\%ProgramFolder%"
If,%cb_ExternalPedrv%,Equal,True,Begin
  // A newer build, or one for another architecture (build.cmd x86 / arm64). Copied as pedrv.exe.
  If,Not,ExistFile,%fb_PedrvExe%,Halt,"%ScriptTitle%: external pedrv.exe [%fb_PedrvExe%] does not exist."
  FileCopy,%fb_PedrvExe%,"%TargetPrograms%\%ProgramFolder%\%ProgramExe%"
  Echo,"Using external pedrv.exe: %fb_PedrvExe%"
End
Else,Begin
  If,Not,%SourceArch%,Equal,x64,Halt,"%ScriptTitle%: the included %ProgramExe% is x64; this PE is %SourceArch%.#$x#$xSelect an external pedrv.exe built for %SourceArch% (build.cmd %SourceArch%)."
  ExtractFile,%ScriptFile%,pedrv,%ProgramExe%,"%TargetPrograms%\%ProgramFolder%"
End

// 7-Zip is needed for .7z sources (and .zip / .wim fallbacks): PhoenixPE's own, for the PE architecture.
If,%cb_Include7z%,Equal,True,Begin
  Set,%SevenZipDir%,"%Tools%\%SourceArch%"
  If,Not,ExistFile,"%SevenZipDir%\7z.exe",Halt,"%ScriptTitle%: 7z.exe was not found in [%SevenZipDir%]."
  FileCopy,"%SevenZipDir%\7z.exe","%TargetPrograms%\%ProgramFolder%"
  FileCopy,"%SevenZipDir%\7z.dll","%TargetPrograms%\%ProgramFolder%"
End

// ---- where the drivers are when the PE runs ----
If,%cmb_DriverSource%,Equal,%IncludeChoice%,Begin
  // Copied into the PE as files (not integrated with DISM), so slim copies made with pedrv /export work too.
  StrFormat,EndTrim,%fb_IncludeDir%,"\",%IncludeDir%
  If,Not,ExistDir,%IncludeDir%,Halt,"%ScriptTitle%: driver folder [%IncludeDir%] does not exist."
  StrFormat,FileName,%IncludeDir%,%IncludeName%
  DirCopy,%IncludeDir%,"%TargetPrograms%\%ProgramFolder%"
  Set,%DriverPath%,"%PEPrograms%\%ProgramFolder%\%IncludeName%"
End
Else,Begin
  // "\PEDrivers" (no drive letter): pedrv looks for it on every drive, as ?:\PEDrivers.
  StrFormat,EndTrim,%txt_MediaPath%,"\",%DriverPath%
  If,%DriverPath%,Equal,"",Halt,"%ScriptTitle%: enter the path of the drivers in the PE."
  StrFormat,Left,%DriverPath%,1,%FirstChar%
  If,%FirstChar%,Equal,"\",Set,%DriverPath%,"?:%DriverPath%"
End

// ---- device classes to skip: /exclude:Display;Media (pedrv accepts ; as well as ,) ----
// ";" keeps the list a single argument for PEBakery, AutoIt and cmd alike.
Set,%Exclude%,""
If,%cb_ExDisplay%,Equal,True,Set,%Exclude%,"%Exclude%;Display"
If,%cb_ExMedia%,Equal,True,Set,%Exclude%,"%Exclude%;Media"
If,%cb_ExNet%,Equal,True,Set,%Exclude%,"%Exclude%;Net"
If,%cb_ExBluetooth%,Equal,True,Set,%Exclude%,"%Exclude%;Bluetooth"
If,%cb_ExCamera%,Equal,True,Set,%Exclude%,"%Exclude%;Camera"
If,%cb_ExBiometric%,Equal,True,Set,%Exclude%,"%Exclude%;Biometric"
If,%cb_ExHIDClass%,Equal,True,Set,%Exclude%,"%Exclude%;HIDClass"
If,%cb_ExUSB%,Equal,True,Set,%Exclude%,"%Exclude%;USB"
If,%cb_ExSCSIAdapter%,Equal,True,Set,%Exclude%,"%Exclude%;SCSIAdapter"
If,%cb_ExHDC%,Equal,True,Set,%Exclude%,"%Exclude%;HDC"
If,%cb_ExSystem%,Equal,True,Set,%Exclude%,"%Exclude%;System"
If,%cb_ExSoftwareComponent%,Equal,True,Set,%Exclude%,"%Exclude%;SoftwareComponent"
StrFormat,Replace,%txt_ExcludeOther%,",",";",%ExcludeOther%
StrFormat,Replace,%ExcludeOther%," ","",%ExcludeOther%
If,Not,%ExcludeOther%,Equal,"",Set,%Exclude%,"%Exclude%;%ExcludeOther%"
// The "without display drivers" shortcuts add Display to the same list.
Set,%ExcludeNoDisplay%,"%Exclude%;Display"
StrFormat,StartTrim,%ExcludeNoDisplay%,";",%ExcludeNoDisplay%
Set,%ExcludeNoDisplayOpt%,"/exclude:%ExcludeNoDisplay% "
Set,%ExcludeOpt%,""
If,Not,%Exclude%,Equal,"",Begin
  StrFormat,StartTrim,%Exclude%,";",%Exclude%
  Set,%ExcludeOpt%,"/exclude:%Exclude% "
End

// ---- command line ----
Set,%PedrvPath%,"%PEPrograms%\%ProgramFolder%\%ProgramExe%"
Set,%PedrvArgs%,"/pe %ExcludeOpt%%txt_Options% #$q%DriverPath%#$q"
Set,%PedrvCmd%,"#$q%PedrvPath%#$q %PedrvArgs%"
Echo,"pedrv command: %PedrvCmd%"

// ---- run at PE startup ----
// PreShell waits for pedrv (the desktop appears after the drivers are loaded); PostShell does not.
// Minimized: a hidden cmd.exe starts pedrv with "start /min", so only a taskbar button shows.
If,%cb_AutoRun%,Equal,True,Begin
  If,%cmb_AutoRunGroup%,Equal,"PreShell - before the desktop",Set,%RunGroup%,PreShell
  Else,Set,%RunGroup%,PostShell
  If,%cmb_AutoRunWindow%,Equal,"Minimized window",Begin
    If,%RunGroup%,Equal,PreShell,AddAutoRun,PreShell,HideWait,"Loading drivers...","cmd.exe","/c start #$q#$q /wait /min %PedrvCmd%"
    Else,AddAutoRun,PostShell,HideNoWait,"Loading drivers...","cmd.exe","/c start #$q#$q /min %PedrvCmd%"
  End
  Else,If,%cmb_AutoRunWindow%,Equal,"Hidden - output to X:\Windows\Temp\pedrv.log",Begin
    If,%RunGroup%,Equal,PreShell,AddAutoRun,PreShell,HideWait,"Loading drivers...","cmd.exe","/c #$q%PedrvCmd% > #$q%LogFile%#$q 2>&1#$q"
    Else,AddAutoRun,PostShell,HideNoWait,"Loading drivers...","cmd.exe","/c #$q%PedrvCmd% > #$q%LogFile%#$q 2>&1#$q"
  End
  Else,If,%cmb_AutoRunWindow%,Equal,"Normal window - waits for a key",Begin
    If,%RunGroup%,Equal,PreShell,AddAutoRun,PreShell,Wait,"Loading drivers...","cmd.exe","/c #$q%PedrvCmd% & pause#$q"
    Else,AddAutoRun,PostShell,NoWait,"Loading drivers...","cmd.exe","/c #$q%PedrvCmd% & pause#$q"
  End
  Else,Begin
    // "Normal window" (also any value saved by an older version of this script)
    If,%RunGroup%,Equal,PreShell,AddAutoRun,PreShell,Wait,"Loading drivers...",%PedrvPath%,%PedrvArgs%
    Else,AddAutoRun,PostShell,NoWait,"Loading drivers...",%PedrvPath%,%PedrvArgs%
  End
End

// ---- shortcuts: a console that stays open to show the result ----
If,%cb_DesktopShc%,Equal,True,AddShortcut,Desktop,"",%txt_ShortcutName%,"X:\Windows\System32\cmd.exe","/k #$q%PedrvCmd%#$q","%PEPrograms%\%ProgramFolder%"
If,%cb_StartMenuShc%,Equal,True,AddShortcut,StartMenu,%txt_StartMenuFolder%,%txt_ShortcutName%,"X:\Windows\System32\cmd.exe","/k #$q%PedrvCmd%#$q","%PEPrograms%\%ProgramFolder%"

// ---- shortcuts: the same without display drivers (where Desktop / Start Menu are ticked above) ----
// Not made when Display is already excluded: the shortcut would be the same as the one above.
If,%cb_NoDisplayShc%,Equal,True,Begin
  If,%cb_ExDisplay%,Equal,True,Echo,"pedrv: Display is already excluded; no separate shortcut without display drivers."
  Else,Begin
    Set,%NoDisplayCmd%,"#$q%PedrvPath%#$q /pe %ExcludeNoDisplayOpt%%txt_Options% #$q%DriverPath%#$q"
    If,%cb_DesktopShc%,Equal,True,AddShortcut,Desktop,"",%txt_NoDisplayShortcutName%,"X:\Windows\System32\cmd.exe","/k #$q%NoDisplayCmd%#$q","%PEPrograms%\%ProgramFolder%"
    If,%cb_StartMenuShc%,Equal,True,AddShortcut,StartMenu,%txt_StartMenuFolder%,%txt_NoDisplayShortcutName%,"X:\Windows\System32\cmd.exe","/k #$q%NoDisplayCmd%#$q","%PEPrograms%\%ProgramFolder%"
    Echo,"pedrv shortcut without display drivers: %NoDisplayCmd%"
  End
End

// ---- shortcuts: drivers of the Windows installed on the disk (/fromwin) ----
// pedrv finds that Windows itself; with several it lists them and stops (the console stays open).
If,%cb_FromWinInbox%,Equal,True,Set,%FromWinArgs%,"/fromwin /inbox %ExcludeOpt%%txt_Options%"
Else,Set,%FromWinArgs%,"/fromwin %ExcludeOpt%%txt_Options%"
Set,%FromWinCmd%,"#$q%PedrvPath%#$q %FromWinArgs%"
If,%cb_FromWinDesktopShc%,Equal,True,AddShortcut,Desktop,"",%txt_FromWinShortcutName%,"X:\Windows\System32\cmd.exe","/k #$q%FromWinCmd%#$q","%PEPrograms%\%ProgramFolder%"
If,%cb_FromWinStartMenuShc%,Equal,True,AddShortcut,StartMenu,%txt_StartMenuFolder%,%txt_FromWinShortcutName%,"X:\Windows\System32\cmd.exe","/k #$q%FromWinCmd%#$q","%PEPrograms%\%ProgramFolder%"
If,%cb_FromWinDesktopShc%,Equal,True,Echo,"pedrv /fromwin shortcut: %FromWinCmd%"
Else,If,%cb_FromWinStartMenuShc%,Equal,True,Echo,"pedrv /fromwin shortcut: %FromWinCmd%"

// /fromwin without display drivers
If,%cb_FromWinNoDisplayShc%,Equal,True,Begin
  If,%cb_ExDisplay%,Equal,True,Echo,"pedrv: Display is already excluded; no separate /fromwin shortcut without display drivers."
  Else,Begin
    If,%cb_FromWinInbox%,Equal,True,Set,%FromWinNoDisplayCmd%,"#$q%PedrvPath%#$q /fromwin /inbox %ExcludeNoDisplayOpt%%txt_Options%"
    Else,Set,%FromWinNoDisplayCmd%,"#$q%PedrvPath%#$q /fromwin %ExcludeNoDisplayOpt%%txt_Options%"
    If,%cb_FromWinDesktopShc%,Equal,True,AddShortcut,Desktop,"",%txt_FromWinNoDisplayShortcutName%,"X:\Windows\System32\cmd.exe","/k #$q%FromWinNoDisplayCmd%#$q","%PEPrograms%\%ProgramFolder%"
    If,%cb_FromWinStartMenuShc%,Equal,True,AddShortcut,StartMenu,%txt_StartMenuFolder%,%txt_FromWinNoDisplayShortcutName%,"X:\Windows\System32\cmd.exe","/k #$q%FromWinNoDisplayCmd%#$q","%PEPrograms%\%ProgramFolder%"
    Echo,"pedrv /fromwin shortcut without display drivers: %FromWinNoDisplayCmd%"
  End
End

[SetDefaultOptions]
System,Cursor,Wait
WriteInterface,Value,%ScriptFile%,Interface,cb_ExternalPedrv,False
WriteInterface,Value,%ScriptFile%,Interface,cb_Include7z,True
WriteInterface,Value,%ScriptFile%,Interface,cb_ExDisplay,False
WriteInterface,Value,%ScriptFile%,Interface,cb_ExMedia,False
WriteInterface,Value,%ScriptFile%,Interface,cb_ExNet,False
WriteInterface,Value,%ScriptFile%,Interface,cb_ExBluetooth,False
WriteInterface,Value,%ScriptFile%,Interface,cb_ExCamera,False
WriteInterface,Value,%ScriptFile%,Interface,cb_ExBiometric,False
WriteInterface,Value,%ScriptFile%,Interface,cb_ExHIDClass,False
WriteInterface,Value,%ScriptFile%,Interface,cb_ExUSB,False
WriteInterface,Value,%ScriptFile%,Interface,cb_ExSCSIAdapter,False
WriteInterface,Value,%ScriptFile%,Interface,cb_ExHDC,False
WriteInterface,Value,%ScriptFile%,Interface,cb_ExSystem,False
WriteInterface,Value,%ScriptFile%,Interface,cb_ExSoftwareComponent,False
WriteInterface,Value,%ScriptFile%,Interface,txt_ExcludeOther,""
WriteInterface,Value,%ScriptFile%,Interface,cmb_DriverSource,"Folder on the boot media or a disk"
WriteInterface,Value,%ScriptFile%,Interface,txt_MediaPath,"\PEDrivers"
WriteInterface,Value,%ScriptFile%,Interface,txt_Options,""
WriteInterface,Value,%ScriptFile%,Interface,cb_AutoRun,False
WriteInterface,Value,%ScriptFile%,Interface,cmb_AutoRunGroup,"PostShell - after the desktop"
WriteInterface,Value,%ScriptFile%,Interface,cmb_AutoRunWindow,"Minimized window"
WriteInterface,Value,%ScriptFile%,Interface,cb_DesktopShc,False
WriteInterface,Value,%ScriptFile%,Interface,cb_StartMenuShc,True
WriteInterface,Value,%ScriptFile%,Interface,txt_StartMenuFolder,"Drivers"
WriteInterface,Value,%ScriptFile%,Interface,txt_ShortcutName,"Load Drivers (pedrv)"
WriteInterface,Value,%ScriptFile%,Interface,cb_NoDisplayShc,False
WriteInterface,Value,%ScriptFile%,Interface,txt_NoDisplayShortcutName,"Load Drivers except Display (pedrv)"
WriteInterface,Value,%ScriptFile%,Interface,cb_FromWinDesktopShc,False
WriteInterface,Value,%ScriptFile%,Interface,cb_FromWinStartMenuShc,True
WriteInterface,Value,%ScriptFile%,Interface,cb_FromWinInbox,False
WriteInterface,Value,%ScriptFile%,Interface,txt_FromWinShortcutName,"Load Drivers from Windows (pedrv)"
WriteInterface,Value,%ScriptFile%,Interface,cb_FromWinNoDisplayShc,False
WriteInterface,Value,%ScriptFile%,Interface,txt_FromWinNoDisplayShortcutName,"Load Drivers from Windows except Display (pedrv)"
System,Cursor,Normal

[ShowScriptInfo]
Message,"pedrv picks the drivers that match this machine from a folder and loads them into the running PE (drvload).#$x#$xSources: folders with .inf files (searched recursively) and the .zip / .7z / .wim files directly inside the folder. A path without a drive letter such as \PEDrivers is looked up on every drive, so it works wherever the boot media is mounted.#$x#$xInclude in the PE image: the folder is copied into the PE as files. It costs RAM twice (the image and the PE driver store); for large display drivers prefer a folder on the boot media.#$x#$xSlim copies (pedrv /export) work with both choices, because the drivers are loaded in the running PE. Do not integrate them with the Driver Integration script (DISM): they are then registered as unsigned and not used.#$x#$xDisplay drivers also need the Display Driver Support script (ForceBddFallbackOnly, DDisplay.dll).#$x#$xThe included pedrv.exe is an x64 build. For an x86 / arm64 PE or a newer build, select an external pedrv.exe.#$x#$xRun at PE startup: Minimized shows only a taskbar button; Hidden shows nothing and writes the output to X:\Windows\Temp\pedrv.log."

